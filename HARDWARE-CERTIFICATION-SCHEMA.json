{
  "schema": 1,
  "required": [
    "machine_id",
    "firmware",
    "cpu",
    "storage",
    "usb",
    "display",
    "evidence_manifest_sha256",
    "result"
  ],
  "allowed_results": [
    "PASS",
    "FAIL",
    "BLOCKED"
  ],
  "physical_boot_approval_requires": [
    "vm_runtime_certification",
    "storage_read_path",
    "keyboard_input",
    "pointing_input",
    "recovery_mode",
    "power_reboot",
    "display_service"
  ]
}
